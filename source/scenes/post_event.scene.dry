title: Post Event
new-page: true
on-arrival: {!
// 1. advance the calendar once an action has been taken this month.
if (Q.month_actions >= 1) {
    Q.time += 1;
    Q.month_actions = 0;
    Q.month += 1;
    if (Q.month >= 13) {
        Q.month = 1;
        Q.year += 1;
        Q.resources += Q.dues;
    }
    // card cooldowns
    for (var t of ['rally', 'fundraising', 'caucus']) {
        if (Q[t + '_timer'] > 0) {
            Q[t + '_timer'] -= 1;
        }
    }
    // faction dissent slowly cools.
    for (var f of Q.factions) {
        Q[f + '_dissent'] = Math.max(0, Q[f + '_dissent'] - 0.5);
    }
    // faction strengths are shares of the party: keep them summing to 100.
    var ssum = 0;
    for (var f of Q.factions) {
        Q[f + '_strength'] = Math.max(1, Q[f + '_strength']);
        ssum += Q[f + '_strength'];
    }
    for (var f of Q.factions) {
        Q[f + '_strength'] = Math.round(1000 * Q[f + '_strength'] / ssum) / 10;
    }
    // campaign gains fade: support drifts back toward the baseline each month.
    for (var g of Q.groups) {
        Q[g + '_fl'] += (Q['base_' + g + '_fl'] - Q[g + '_fl']) * 0.08;
    }
}

// 2. is it election season? House elections are held every November of an even year.
Q.is_election = 0;
if (Q.month == 11 && Q.year % 2 == 0 && Q.last_election_time != Q.time) {
    Q.is_election = 1;
    Q.election_live = 1;
    Q.last_election_time = Q.time;
}

// 3. the game runs through 1936.
if (Q.year >= 1937) {
    Q.finished = 1;
}

// 4. are there any events waiting?
Q.has_event = 0;
var scene = this.game.scenes['post_event.events_choice'];
var choices = this._compileChoices(scene);
if (choices && choices.length > 0 && choices[0].title != "Continue...") {
    Q.has_event = 1;
}
!}
go-to: ending if finished = 1; root.election_calc if is_election = 1 and finished = 0; events_choice if has_event = 1 and is_election = 0 and finished = 0; main if has_event = 0 and is_election = 0 and finished = 0

= [+ month : month +] [+ year +]

@events_choice

- #event
