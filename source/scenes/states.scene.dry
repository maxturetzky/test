title: State Setup
new-page: true
on-arrival: {!
// One row per state: [abbreviation, name, region, House seats (1913-1933 apportionment), party multipliers].
//
// The multipliers scale a party's vote in that state relative to its region. 1 is neutral, and
// anything left out is 1. They set each state's vote share (for statewide contests such as the
// presidency and the Senate); House seats are decided by region, from the region's overall vote.
// They are rescaled at election time so that each region's seat-weighted average stays at 1, so
// they only say which states run above or below their region. The exception is the South, which
// isn't calibrated to its demographics, so its multipliers are absolute: the border states'
// large Republican multipliers are what give the South a Republican vote share at all. Events
// can change them during play, for example Q.mod_MN_fl += 0.05.
var states = [
    // FL Heartland
    ['MN', 'Minnesota', 'heartland', 10, {fl: 1.30, dem: 0.85}],
    ['WI', 'Wisconsin', 'heartland', 11, {fl: 1.20}],
    ['ND', 'North Dakota', 'heartland', 3, {fl: 1.30, dem: 0.80}],
    ['SD', 'South Dakota', 'heartland', 3, {fl: 1.00, rep: 1.05}],
    ['IA', 'Iowa', 'heartland', 11, {fl: 0.90, rep: 1.05}],
    ['NE', 'Nebraska', 'heartland', 6, {fl: 1.00, dem: 1.10}],
    ['KS', 'Kansas', 'heartland', 8, {fl: 0.85, rep: 1.10}],
    ['OK', 'Oklahoma', 'heartland', 8, {fl: 1.10, dem: 1.15}],
    ['MT', 'Montana', 'heartland', 2, {fl: 1.10, dem: 1.10}],
    ['ID', 'Idaho', 'heartland', 2, {fl: 0.85, rep: 1.05}],

    // Industrial Belt
    ['ME', 'Maine', 'industrial_belt', 4, {fl: 0.85, rep: 1.10}],
    ['NH', 'New Hampshire', 'industrial_belt', 2, {fl: 0.85, rep: 1.10}],
    ['VT', 'Vermont', 'industrial_belt', 2, {fl: 0.70, rep: 1.15}],
    ['MA', 'Massachusetts', 'industrial_belt', 16, {fl: 0.85, dem: 1.20, rep: 0.95}],
    ['RI', 'Rhode Island', 'industrial_belt', 3, {dem: 1.10}],
    ['CT', 'Connecticut', 'industrial_belt', 5, {fl: 0.85, rep: 1.10}],
    ['NY', 'New York', 'industrial_belt', 43, {fl: 1.05, dem: 1.15, rep: 0.95}],
    ['NJ', 'New Jersey', 'industrial_belt', 12, {fl: 0.95, dem: 1.10}],
    ['PA', 'Pennsylvania', 'industrial_belt', 36, {fl: 0.90, rep: 1.10}],
    ['DE', 'Delaware', 'industrial_belt', 1, {rep: 1.05}],
    ['WV', 'West Virginia', 'industrial_belt', 6, {fl: 1.10, rep: 1.10}],
    ['OH', 'Ohio', 'industrial_belt', 22, {fl: 1.05}],
    ['IN', 'Indiana', 'industrial_belt', 13, {fl: 1.00, rep: 1.05}],
    ['MI', 'Michigan', 'industrial_belt', 13, {fl: 1.00}],
    ['IL', 'Illinois', 'industrial_belt', 27, {fl: 1.05, dem: 1.10}],

    // The South (the Republican multipliers are what make the border states competitive)
    ['AL', 'Alabama', 'south', 10, {}],
    ['AR', 'Arkansas', 'south', 7, {}],
    ['FL', 'Florida', 'south', 4, {}],
    ['GA', 'Georgia', 'south', 12, {}],
    ['LA', 'Louisiana', 'south', 8, {}],
    ['MS', 'Mississippi', 'south', 8, {}],
    ['NC', 'North Carolina', 'south', 10, {rep: 2.4}],
    ['SC', 'South Carolina', 'south', 7, {}],
    ['TN', 'Tennessee', 'south', 10, {rep: 3.2}],
    ['TX', 'Texas', 'south', 18, {}],
    ['VA', 'Virginia', 'south', 10, {rep: 3.0}],
    ['KY', 'Kentucky', 'south', 11, {rep: 4.5}],
    ['MO', 'Missouri', 'south', 16, {rep: 3.2}],
    ['MD', 'Maryland', 'south', 6, {rep: 3.5}],

    // The West
    ['WA', 'Washington', 'west', 5, {fl: 1.30}],
    ['OR', 'Oregon', 'west', 3, {fl: 1.05}],
    ['CA', 'California', 'west', 11, {fl: 1.05}],
    ['NV', 'Nevada', 'west', 1, {dem: 1.10}],
    ['UT', 'Utah', 'west', 2, {fl: 0.75, rep: 1.10}],
    ['AZ', 'Arizona', 'west', 1, {fl: 0.95, dem: 1.20}],
    ['NM', 'New Mexico', 'west', 1, {fl: 0.85, dem: 1.15}],
    ['CO', 'Colorado', 'west', 4, {fl: 1.05}],
    ['WY', 'Wyoming', 'west', 1, {fl: 0.95, rep: 1.05}]
];

Q.state_ids = [];
for (var r of Q.regions) {
    Q['seats_total_' + r] = 0;
}
for (var s of states) {
    var id = s[0];
    Q.state_ids.push(id);
    Q['st_' + id + '_name'] = s[1];
    Q['st_' + id + '_region'] = s[2];
    Q['st_' + id + '_seats'] = s[3];
    Q['seats_total_' + s[2]] += s[3];
    for (var p of Q.parties) {
        Q['mod_' + id + '_' + p] = s[4][p] || 1;
    }
}

// The Senate. One row per state: [state, party of one seat, that seat's class, party of the other
// seat, that seat's class]. Parties are 'rep', 'dem' and 'fl'.
//
// Classes are the real ones: Class 1 is up in 1928 and 1934, Class 2 in 1930 and 1936, and Class 3
// in 1932. A state's two seats are always in different classes.
var senate = [
    ['AL', 'dem', 2, 'dem', 3],
    ['AZ', 'dem', 1, 'dem', 3],
    ['AR', 'dem', 2, 'dem', 3],
    ['CA', 'rep', 1, 'rep', 3],
    ['CO', 'rep', 2, 'rep', 3],
    ['CT', 'rep', 1, 'rep', 3],
    ['DE', 'dem', 1, 'rep', 2],
    ['FL', 'dem', 1, 'dem', 3],
    ['GA', 'dem', 2, 'dem', 3],
    ['ID', 'rep', 2, 'rep', 3],
    ['IL', 'rep', 2, 'rep', 3],
    ['IN', 'rep', 1, 'rep', 3],
    ['IA', 'dem', 2, 'fl', 3],
    ['KS', 'rep', 2, 'rep', 3],
    ['KY', 'rep', 2, 'dem', 3],
    ['LA', 'dem', 2, 'dem', 3],
    ['ME', 'rep', 1, 'rep', 2],
    ['MD', 'dem', 1, 'dem', 3],
    ['MA', 'dem', 1, 'rep', 2],
    ['MI', 'rep', 1, 'rep', 2],
    ['MN', 'fl', 1, 'fl', 2],
    ['MS', 'dem', 1, 'dem', 2],
    ['MO', 'dem', 1, 'dem', 3],
    ['MT', 'fl', 1, 'dem', 2],
    ['NE', 'rep', 1, 'rep', 2],
    ['NV', 'rep', 1, 'dem', 3],
    ['NH', 'rep', 2, 'rep', 3],
    ['NJ', 'dem', 1, 'rep', 2],
    ['NM', 'rep', 1, 'dem', 2],
    ['NY', 'dem', 1, 'dem', 3],
    ['NC', 'dem', 2, 'dem', 3],
    ['ND', 'fl', 1, 'fl', 3],
    ['OH', 'rep', 1, 'rep', 3],
    ['OK', 'rep', 2, 'fl', 3],
    ['OR', 'rep', 2, 'rep', 3],
    ['PA', 'rep', 1, 'rep', 3],
    ['RI', 'rep', 1, 'dem', 2],
    ['SC', 'dem', 2, 'dem', 3],
    ['SD', 'rep', 2, 'fl', 3],
    ['TN', 'dem', 1, 'dem', 2],
    ['TX', 'dem', 1, 'dem', 2],
    ['UT', 'rep', 1, 'dem', 3],
    ['VT', 'rep', 1, 'rep', 3],
    ['VA', 'dem', 1, 'dem', 2],
    ['WA', 'dem', 1, 'rep', 3],
    ['WV', 'dem', 1, 'rep', 2],
    ['WI', 'fl', 1, 'fl', 3],
    ['WY', 'dem', 1, 'rep', 2]
];

for (var row of senate) {
    var id = row[0];
    Q['sen_' + id + '_1'] = row[1];
    Q['sen_' + id + '_1_class'] = row[2];
    Q['sen_' + id + '_2'] = row[3];
    Q['sen_' + id + '_2_class'] = row[4];
}
// bonus, in points of vote share, for the party holding a Senate seat.
Q.senate_incumbency = 20;
Q.senate_majority = 49;
!}
go-to: root.election_calc
