<span style="color: #8B5A2B;">**Southern Democrats**</span>: [+ sen_bloc_southern_dem +]
<span style="color: #D98C3F;">**Northern Democrats**</span>: [+ sen_bloc_northern_dem +]
<span style="color: #C0392B;">**Farmer-Labor**</span>: [+ sen_bloc_fl +]

= Last Election

<span style="color: #1F4E9C;">**Republicans**</span>: [+ vote_rep +]%
<span style="color: #B5651D;">**Democrats**</span>: [+ vote_dem +]%
<span style="color: #C0392B;">**Farmer-Labor**</span>: [+ vote_fl +]%

Farmer-Labor seats by region

The Heartland: [+ seats_heartland_fl +] of [+ seats_total_heartland +] ([+ share_heartland_fl +]%)
The Industrial Belt: [+ seats_industrial_belt_fl +] of [+ seats_total_industrial_belt +] ([+ share_industrial_belt_fl +]%)
The West: [+ seats_west_fl +] of [+ seats_total_west +] ([+ share_west_fl +]%)


@polls
on-arrival: {!
// projection: run the election model on today's support, without noise, and keep the results
// separate from the real House.
if (Q.started) {
    var result = window.computeElection(Q, false);
    window.storeElection(Q, result, 'poll_');
    Q.next_election_year = window.nextElectionYear(Q);
    window.storeSenate(Q, window.computeSenate(Q, result, Q.next_election_year), 'poll_');
    // each group's current support as a percentage of its vote.
    for (var g of Q.groups) {
        var total = 0;
        for (var p of Q.parties) {
            total += Q[g + '_' + p];
        }
        for (var p of Q.parties) {
            Q['poll_' + g + '_' + p] = Math.round(100 * Q[g + '_' + p] / total);
        }
    }
}
!}

