title: Status
new-page: true
is-special: true
on-arrival: {!
Q.next_election_year = Q.year;
if (Q.year % 2 == 1) {
    Q.next_election_year = Q.year + 1;
} else if (Q.month >= 11) {
    Q.next_election_year = Q.year + 2;
}
!}

