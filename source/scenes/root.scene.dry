title: Root Scene
new-page: true
go-to: post_event if started = 1; start_menu if started = 0

@start_menu
new-page: true

= Farmer-Labor: An Alternate History

*It is January 1928. The Great War never came.*

- @start: Start game
- @credits: Credits

@credits
new-page: true

= Credits

*Farmer-Labor: An Alternate History* is a fork of *Social Democracy: An Alternate History* by Autumn Chen, built with Dendry and dendrynexus. The game engine, interface and much of the structure come from that project (MIT license).

- @start_menu: Back

@start
new-page: true
on-arrival: {!
Q.started = 1;
Q.time = 1;
Q.year = 1928;
Q.month = 1;
Q.month_actions = 0;
Q.last_election_time = 0;
Q.election_live = 0;
Q.finished = 0;

// party resources: organizers, funds and goodwill, all in one.
Q.resources = 3;
Q.dues = 3;

// the four voting-bloc parties and the seven demographic groups.
Q.parties = ['rep', 'dem', 'fl'];
Q.groups = ['farmers', 'southern_whites', 'urban_ethnic', 'tradesmen', 'industrial', 'business', 'small_town'];
Q.regions = ['heartland', 'industrial_belt', 'south', 'west'];

// each region's share of the national electorate (percent of voters). These were fitted so that
// the regions' demographic mixes add up to the national group shares in the design document.
// They only affect the national popular vote figure; seats are decided within each state.
Q.voters_heartland = 23;
Q.voters_industrial_belt = 37.5;
Q.voters_south = 24.5;
Q.voters_west = 15;

// share of each region's electorate made up of each group (percent).
var mix = {
    heartland: {farmers: 38, southern_whites: 0, urban_ethnic: 10, tradesmen: 6, industrial: 9, business: 5, small_town: 32},
    industrial_belt: {farmers: 4, southern_whites: 0, urban_ethnic: 26, tradesmen: 12, industrial: 14, business: 18, small_town: 26},
    south: {farmers: 0, southern_whites: 90, urban_ethnic: 1, tradesmen: 2, industrial: 3, business: 2, small_town: 2},
    west: {farmers: 16, southern_whites: 0, urban_ethnic: 14, tradesmen: 8, industrial: 18, business: 10, small_town: 34}
};
// support for each party by group. Doesn't need to sum to 100; the election normalizes.
var sup = {
    farmers: {rep: 44, dem: 6, fl: 50},
    southern_whites: {rep: 6, dem: 94, fl: 0},
    urban_ethnic: {rep: 32, dem: 40, fl: 28},
    tradesmen: {rep: 63, dem: 16, fl: 21},
    industrial: {rep: 40, dem: 25, fl: 35},
    business: {rep: 86, dem: 12, fl: 2},
    small_town: {rep: 63, dem: 15, fl: 22}
};
for (var r of Q.regions) {
    for (var g of Q.groups) {
        Q['mix_' + r + '_' + g] = mix[r][g];
    }
    for (var p of Q.parties) {
        // regional organization modifier on a party's vote (1 = neutral).
        Q['mod_' + r + '_' + p] = 1;
        // how geographically concentrated a party's vote is (>1 wins more seats than its share implies).
        Q['conc_' + r + '_' + p] = 1;
    }
}
for (var g of Q.groups) {
    for (var p of Q.parties) {
        Q[g + '_' + p] = sup[g][p];
    }
    // Farmer-Labor's baseline in each group; campaign gains fade back toward it over time.
    Q['base_' + g + '_fl'] = sup[g].fl;
}
// regional adjustments: a multiplier on each party's vote in the region (1 = no change), applied on
// top of the demographic makeup. The South has none.
Q.mod_heartland_fl = 1.55;
Q.mod_heartland_rep = 0.85;
Q.mod_heartland_dem = 0.75;
Q.mod_industrial_belt_fl = 0.8;
Q.mod_industrial_belt_rep = 1.05;
Q.mod_industrial_belt_dem = 1.7;
Q.mod_west_fl = 1.1;
Q.mod_west_rep = 0.95;
Q.mod_west_dem = 0.9;
// House seats are decided by region. These factors stand in for how tightly a party's vote is packed
// into districts: FL's in farm counties, mining districts and mill towns, the Republicans' in the
// South's border states. The Democrats have none in the Industrial Belt (1). A factor above 1 wins a
// party more seats than its vote share alone would. They are fitted values, not sourced from anywhere.
// They were fitted before the regional adjustments above were added, so they have not been refitted.
Q.conc_heartland_fl = 2;
Q.conc_industrial_belt_fl = 2;
Q.conc_industrial_belt_dem = 1;
Q.conc_west_fl = 1.2;
Q.conc_south_rep = 2.5;

Q.house_majority = 218;

// Farmer-Labor's internal factions.
Q.factions = ['socialists', 'populists', 'unionists', 'progressives'];
Q.socialists_strength = 22;
Q.socialists_dissent = 10;
Q.populists_strength = 32;
Q.populists_dissent = 5;
Q.unionists_strength = 26;
Q.unionists_dissent = 5;
Q.progressives_strength = 20;
Q.progressives_dissent = 10;
Q.dissent_percent = 7;
!}
go-to: states

@election_calc
on-arrival: {!
// the election model lives in election.js, shared with the polls tab.
var result = window.computeElection(Q, Q.election_live == 1);
window.storeElection(Q, result, '');
// Senate seats in the class that is up go to the leading party in each state.
var senate = window.computeSenate(Q, result, Q.election_live == 1 ? Q.year : null);
window.storeSenate(Q, senate, '');
Q.dissent_percent = result.dissent;
!}
go-to: election_results if election_live = 1; main if election_live = 0
