title: Root Scene
new-page: true
go-to: post_event if started = 1; start_menu if started = 0

@start_menu
new-page: true

= Farmer-Labor: An Alternate History

*It is January 1928. The Great War never came.*

- @start: Start game
- @credits: Credits

@credits
new-page: true

= Credits

*Farmer-Labor: An Alternate History* is a fork of *Social Democracy: An Alternate History* by Autumn Chen, built with Dendry and dendrynexus. The game engine, interface and much of the structure come from that project (MIT license).

- @start_menu: Back

@start
new-page: true
on-arrival: {!
Q.started = 1;
Q.time = 1;
Q.year = 1928;
Q.month = 1;
Q.month_actions = 0;
Q.last_election_time = 0;
Q.election_live = 0;
Q.finished = 0;

// party resources: organizers, funds and goodwill, all in one.
Q.resources = 3;
Q.dues = 3;

// the four voting-bloc parties and the seven demographic groups.
Q.parties = ['rep', 'dem', 'fl'];
Q.groups = ['farmers', 'southern_whites', 'urban_ethnic', 'tradesmen', 'industrial', 'business', 'small_town'];
Q.regions = ['heartland', 'industrial_belt', 'south', 'west'];

// each region's share of the national electorate (percent of voters). These were fitted so that
// the regions' demographic mixes add up to the national group shares in the design document.
// They only affect the national popular vote figure; seats are decided within each state.
Q.voters_heartland = 23;
Q.voters_industrial_belt = 37.5;
Q.voters_south = 24.5;
Q.voters_west = 15;

// share of each region's electorate made up of each group (percent).
var mix = {
    heartland: {farmers: 38, southern_whites: 0, urban_ethnic: 8, tradesmen: 7, industrial: 9, business: 6, small_town: 32},
    industrial_belt: {farmers: 5, southern_whites: 0, urban_ethnic: 26, tradesmen: 12, industrial: 13, business: 18, small_town: 26},
    south: {farmers: 0, southern_whites: 90, urban_ethnic: 2, tradesmen: 2, industrial: 2, business: 4, small_town: 0},
    west: {farmers: 15, southern_whites: 0, urban_ethnic: 16, tradesmen: 10, industrial: 18, business: 10, small_town: 31}
};
// support for each party by group. Doesn't need to sum to 100; the election normalizes.
var sup = {
    farmers: {rep: 32, dem: 10, fl: 58},
    southern_whites: {rep: 6, dem: 92, fl: 2},
    urban_ethnic: {rep: 26, dem: 52, fl: 22},
    tradesmen: {rep: 50, dem: 24, fl: 26},
    industrial: {rep: 34, dem: 26, fl: 40},
    business: {rep: 78, dem: 19, fl: 3},
    small_town: {rep: 62, dem: 21, fl: 17}
};
for (var r of Q.regions) {
    for (var g of Q.groups) {
        Q['mix_' + r + '_' + g] = mix[r][g];
    }
    for (var p of Q.parties) {
        // regional organization modifier on a party's vote (1 = neutral).
        Q['mod_' + r + '_' + p] = 1;
        // how geographically concentrated a party's vote is (>1 wins more seats than its share implies).
        Q['conc_' + r + '_' + p] = 1;
    }
}
for (var g of Q.groups) {
    for (var p of Q.parties) {
        Q[g + '_' + p] = sup[g][p];
    }
    // Farmer-Labor's baseline in each group; campaign gains fade back toward it over time.
    Q['base_' + g + '_fl'] = sup[g].fl;
}
Q.conc_heartland_fl = 1.5;
Q.conc_west_fl = 1.2;
Q.conc_industrial_belt_dem = 1.1;

// how much of the Republican bloc is the Liberal wing, and of the northern Democrats the Bourbons (percent).
Q.liberal_share = 9;
Q.bourbon_share = 7;

// Farmer-Labor's internal factions.
Q.factions = ['socialists', 'populists', 'unionists', 'progressives'];
Q.socialists_strength = 22;
Q.socialists_dissent = 10;
Q.populists_strength = 32;
Q.populists_dissent = 5;
Q.unionists_strength = 26;
Q.unionists_dissent = 5;
Q.progressives_strength = 20;
Q.progressives_dissent = 10;
Q.dissent_percent = 7;
!}
go-to: states

@election_calc
on-arrival: {!
var regions = Q.regions;
var parties = Q.parties;
var groups = Q.groups;
var live = Q.election_live == 1;
var K = 3; // seat-winning exponent: winner-take-all districts reward the leading party

// overall factional dissent, weighted by faction strength, hurts the party at the polls.
var dsum = 0, ssum = 0;
for (var f of Q.factions) {
    dsum += Q[f + '_strength'] * Q[f + '_dissent'];
    ssum += Q[f + '_strength'];
}
Q.dissent_percent = Math.round(dsum / ssum);

var natVotes = {rep: 0, dem: 0, fl: 0};
var natWeight = 0;
var natSeats = {rep: 0, dem: 0, fl: 0};
var flStates = [];

for (var r of regions) {
    var stateIds = Q.state_ids.filter(function (id) { return Q['st_' + id + '_region'] == r; });
    var regionSeats = {rep: 0, dem: 0, fl: 0};
    var regionShare = {rep: 0, dem: 0, fl: 0};
    var regionWeight = 0;

    // the region's baseline vote from its demographic makeup.
    var base = {};
    for (var p of parties) {
        var v = 0;
        for (var g of groups) {
            v += Q['mix_' + r + '_' + g] * Q[g + '_' + p];
        }
        v *= Q['mod_' + r + '_' + p];
        if (p == 'fl') {
            v *= (1 - Q.dissent_percent / 200);
        }
        // small random regional swing in a real election.
        if (live) {
            v *= 1 + (Math.random() - 0.5) * 0.04;
        }
        base[p] = v;
    }

    // state multipliers are rescaled so that their seat-weighted average in the region is 1.
    var norm = {};
    for (var p of parties) {
        var msum = 0, wsum = 0;
        for (var id of stateIds) {
            msum += Q['st_' + id + '_seats'] * Q['mod_' + id + '_' + p];
            wsum += Q['st_' + id + '_seats'];
        }
        // the South isn't calibrated to demographics, so its multipliers are used as they are.
        norm[p] = (r == 'south') ? 1 : msum / wsum;
    }

    for (var id of stateIds) {
        var N = Q['st_' + id + '_seats'];
        var raw = {};
        var total = 0;
        for (var p of parties) {
            var v = base[p] * Q['mod_' + id + '_' + p] / norm[p];
            // Farmer-Labor doesn't contest the Jim Crow South.
            if (r == 'south' && p == 'fl') {
                v = 0;
            }
            if (live) {
                v *= 1 + (Math.random() - 0.5) * 0.02;
            }
            raw[p] = v;
            total += v;
        }
        var seatsHere = {rep: 0, dem: 0, fl: 0};
        // cube-law style allocation, with a per-party concentration multiplier.
        var w = {};
        var wtotal = 0;
        for (var p of parties) {
            w[p] = Math.pow(raw[p] / total, K) * Q['conc_' + r + '_' + p];
            wtotal += w[p];
        }
        var used = 0;
        var rem = [];
        for (var p of parties) {
            var x = N * w[p] / wtotal;
            seatsHere[p] = Math.floor(x);
            used += seatsHere[p];
            rem.push([x - seatsHere[p], p]);
        }
        rem.sort(function (a, b) { return b[0] - a[0]; });
        for (var i = 0; used < N; i++, used++) {
            seatsHere[rem[i][1]] += 1;
        }
        for (var p of parties) {
            var share = 100 * raw[p] / total;
            Q['share_' + id + '_' + p] = Math.round(share * 10) / 10;
            Q['seats_' + id + '_' + p] = seatsHere[p];
            regionSeats[p] += seatsHere[p];
            regionShare[p] += share * N;
        }
        regionWeight += N;
        if (seatsHere.fl > 0) {
            flStates.push([Q['st_' + id + '_name'], seatsHere.fl, N]);
        }
    }

    for (var p of parties) {
        var regionAverage = regionShare[p] / regionWeight;
        Q['share_' + r + '_' + p] = Math.round(10 * regionAverage) / 10;
        Q['seats_' + r + '_' + p] = regionSeats[p];
        natVotes[p] += regionAverage * Q['voters_' + r];
        natSeats[p] += regionSeats[p];
    }
    natWeight += Q['voters_' + r];
}

for (var p of parties) {
    Q['vote_' + p] = Math.round(10 * natVotes[p] / natWeight) / 10;
    Q['seats_' + p] = natSeats[p];
}

// Farmer-Labor's strongest states, for display.
flStates.sort(function (a, b) { return b[1] - a[1]; });
Q.fl_state_summary = flStates.map(function (s) { return s[0] + ' ' + s[1] + '/' + s[2]; }).join(', ');

// break the House down into the six congressional blocs.
Q.bloc_liberals = Math.round(Q.seats_rep * Q.liberal_share / 100);
Q.bloc_old_guard = Q.seats_rep - Q.bloc_liberals;
Q.bloc_southern = Q.seats_south_dem;
var northernDems = Q.seats_dem - Q.seats_south_dem;
Q.bloc_bourbon = Math.round(northernDems * Q.bourbon_share / 100);
Q.bloc_machine = northernDems - Q.bloc_bourbon;
Q.bloc_fl = Q.seats_fl;
Q.house_majority = 218;
!}
go-to: election_results if election_live = 1; main if election_live = 0
